{
    "name": "sharkyphp/installer",
    "description": "SharkyPHP installer,SharkyPHP application installer.",
    "type": "library",
    "license": "MIT",
    "bin": [
        "bin/sharky"
    ],
    "autoload": {
        "psr-4": {
            "Sharky\\Installer\\": "src"
        }
    },
    "authors": [
        {
            "name": "bytesharky",
            "email": "fish@doffish.com"
        }
    ],
    "require": {
        "php": ">=8.2",
        "sharkyphp/annotation": "^2.0.0"
    },
    "archive": {
        "exclude": [
            "docs/",
            "tests/",
            ".github/",
            ".gitignore",
            "composer.lock",
            "vendor/",
            ".env"
        ]
    }
}
