# 将这个文件复制一份并命名为 .env，然后修改里面的配置项即可

# base configuration
APP_ENV          = development
APP_DEBUG        = true

# database configuration
DB_TYPE          = mysql
DB_DRIVER        = pdo
DB_USER          = root
DB_PASS          = 123456
DB_PREFIX        = sharky_
DB_DATABASE      = boss_zhipin
DB_CHARSET       = utf8mb4
DB_PERSISTENT    = false

DB_MASTER        = localhost
DB_SLAVE         = localhost
DB_PORT          = 3306
DB_TIMEOUT       = 0

# redis configuration
REDIS_DRIVER     = phpredis
REDIS_PASS       = 123456
REDIS_DB         = 0
REDIS_PREFIX     = sharky_
REDIS_PERSISTENT = false

REDIS_MASTER     = localhost
REDIS_SLAVE      = localhost
REDIS_PORT       = 6379
REDIS_TIMEOUT    = 0

# JWT configuration
JWT_SECRETKEY    = 
JWT_ALGORITHM    = HS256